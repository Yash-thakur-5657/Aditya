# ---- Server ----
PORT=8080
NODE_ENV=production
# Public base URL of this backend once deployed (used to build Twilio webhook URLs).
# e.g. https://voice-agent.yourdomain.com  (use ngrok URL for local testing)
PUBLIC_BASE_URL=https://your-deployed-domain.com
DATABASE_PATH=./data/realty.db

# ---- Conversation brain ----
# "anthropic" (Claude, paid, no free tier) or "gemini" (free tier, no card needed - good for testing)
LLM_PROVIDER=anthropic

# ---- Anthropic (used when LLM_PROVIDER=anthropic) ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Gemini (used when LLM_PROVIDER=gemini) ----
# Free API key, no credit card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.0-flash

# ---- Deepgram (real-time speech-to-text, Hindi+English) ----
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- ElevenLabs (text-to-speech, Indian female bilingual voice) ----
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Pick a multilingual Indian-accented female voice from your ElevenLabs Voice Library
# (Voices > Voice Library > filter language "Hindi"/"Indian English"), then paste its Voice ID here.
ELEVENLABS_VOICE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# ---- Twilio (telephony + WhatsApp) ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The voice-enabled number buyers/renters call (E.164 format)
TWILIO_VOICE_NUMBER=+91xxxxxxxxxx
# WhatsApp-enabled Twilio sender (sandbox: whatsapp:+14155238886, or your approved WhatsApp Business number)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ---- Frontend ----
# Origin(s) allowed to call this API, comma separated
CORS_ORIGIN=http://localhost:5173
